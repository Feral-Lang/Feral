# lib/std/package.fer
# Package build-description API, imported in a package's package.fer.
# Pure data-description: no side effects, no filesystem, no network.
# The package manager reads the resulting description to resolve, build, and install.
#
# API:
#   package.new(...)                                -> Package    declare a package
#   Package.requires(name, versionConstraint, .kw)  -> Dependency declare a dependency
#   Package.addTarget(name, sources...)             -> Target     declare a build target

let io = import('std/io');
let fs = import('std/fs');
let map = import('std/map');
let vec = import('std/vec');
let time = import('std/time');
let version = import('std/version');

################################################################################
# Main setup
################################################################################

let home = feral.libPath / 'pkg';
let tempRoot = feral.tempPath / 'pkg';
let indexRoot = home / 'indexes';
let installRoot = home / 'installed';

fs.mkdir(tempRoot, indexRoot, installRoot);

let getInstallPath = fn(name, vers) {
    return installRoot / (name.lower() + '--' + vers.str());
};

let getTempPath = fn(name, vers) {
    return tempRoot / (name.lower() + '--' + vers.str());
};

let getLockPath = fn(dir) {
    return dir / 'package.lock';
};

let getScriptPath = fn(dir) {
    return dir / 'package.fer';
};

################################################################################
# Global config
################################################################################

let globalConfigVars = map.new(refs = true);

"
  fn(name, val) -> Nil
Set the global config `name` as value `val`.
"
let setGlobalConfigVar = fn(name, val) {
    globalConfigVars.insert(name, val);
};

################################################################################
# Target
################################################################################

let Definition = struct(
    value = nil,
    private = true
);
Definition.setTypeName('Definition');

let Target = struct(
    name = 'SampleTarget',
    static = false,
    binary = false,
    headers = vec.new(),
    sources = vec.new(),
    definitions = map.new(refs = true), # <key> = <Definition>
    dependencies = vec.new(refs = true) # can only be of type Target
);
Target.setTypeName('Target');

"
  Target.addHeaders(headers...) -> Nil
Add headers as dependencies for compilation.
Unlike sources, these are not passed to the toolchain compiler.
"
let addHeaders in Target = fn(headers...) {
    self.headers.append(headers);
};

"
  Target.addSources(sources...) -> Nil
Add sources for compilation. These are passed to the compiler.
"
let addSources in Target = fn(sources...) {
    self.sources.append(sources);
};

"
  Target.findHeaders(.kw, path, searchRegex = '(.*).hpp') -> Nil
Find all headers in `path` using `searchRegex` and add in the headers list.
Takes the following keyword arguments:
* `skip = Vec<Str>` - ignore all the paths that have any of these (sub)strings.
"
let findHeaders in Target = fn(.kw, path, searchRegex = '(.*).hpp') {
    if !fs.exists(path) {
        raise('provided path for searching for headers: ', path, ' does not exist');
    }
    let skip = ref(kw['skip']) ?? vec.new();
    let files = fs.walkDir(path, fs.WALK_RECURSE, searchRegex);
    files.sort();
    for let i = 0; i < files.len(); ++i {
        let fstr = files[i].str();
        let found = false;
        for s in skip.each() {
            if fstr.find(s) < 0 { continue; }
            found = true;
            break;
        }
        if !found { continue; }
        files.erase(i--);
    }
    self.addHeaders(files...);
};

"
  Target.findSources(.kw, path, searchRegex = '(.*).cpp') -> Nil
Find all sources in `path` using `searchRegex` and add in the sources list.
Takes the following keyword arguments:
* `skip = Vec<Str>` - ignore all the paths that have any of these (sub)strings.
"
let findSources in Target = fn(.kw, path, searchRegex = '(.*).cpp') {
    if !fs.exists(path) {
        raise('provided path for searching for sources: ', path, ' does not exist');
    }
    let skip = ref(kw['skip']) ?? vec.new();
    let files = fs.walkDir(path, fs.WALK_RECURSE, searchRegex);
    files.sort();
    for let i = 0; i < files.len(); ++i {
        let fstr = files[i].str();
        let found = false;
        for s in skip.each() {
            if fstr.find(s) < 0 { continue; }
            found = true;
            break;
        }
        if !found { continue; }
        files.erase(i--);
    }
    self.addSources(files...);
};

"
  Target.addDefinition(.kw, name, val = '') -> Nil
Add definitions to be available when compiling the target.
Accepts the following keyword arguments:
* `private = true/false` - if `true`, the definition is not transitive - ie, not applied to any dependent. (default: true)
"
let addDefinition in Target = fn(.kw, name, val = '') {
    let private = kw['private'] ?? true;
    self.definitions.insert(name, Definition(ref(val), private));
};

"
  Target.requires(targets...) -> Nil
Make this target depend on each of `targets`.
"
let requires in Target = fn(targets...) {
    self.dependencies.append(targets);
};

################################################################################
# Dependency
################################################################################

let Dependency = struct(
    name = 'SampleDependency',
    constraint = '*',
    isFeral = false # false => native library (like libcurl); true => feral package (like LibMP)
);
Dependency.setTypeName('Dependency');

################################################################################
# Package
################################################################################

let Package = struct(
    name = 'SampleProject',
    desc = 'A good but brief description here',
    feral = version.parseConstraint('*'),
    version = version.parse('0.0.1'),
    license = 'MIT',
    authors = vec.new(
        'ProjectAuthor <author@email.com>'
    ),
    configVars = map.new(refs = true),
    configFiles = map.new(refs = true), # source -> dest
    definitions = map.new(refs = true), # <key> = <Definition> (no use of `private` field)
    headers = vec.new(refs = true),
    targets = vec.new(refs = true),
    dependencies = vec.new(refs = true) # can only be of type Dependency
);
Package.setTypeName('Package');

"
  fn(.kw, name) -> Project
Declares a new package project with name as `name`. Accepts keyword arguments:
  desc    — short description
  version — version string (e.g. '1.2.3'); validated via version.parse() (default: 0.0.1)
  binary  - if true, package is expected to emit an executable (feral/otherwise)
            which is then installed globally in feral paths. (default: false)
            Only 1 version of this type of package may be installed.
  feral   — Feral interpreter version constraint (e.g. '>=2.0.1');
            raises immediately if the running interpreter does not satisfy it
  authors — vec of author strings (e.g. 'Name <email>')
The created Project is registered in getProjects() and returned.
"
let new  = fn(.kw, name) {
    let package = Package();
    package.name = name;
    if kw['desc'] != nil { package.desc = kw['desc']; }
    if kw['feral'] != nil { package.feral = version.parseConstraint(kw['feral']); }
    if kw['version'] != nil { package.version = version.parse(kw['version']); }
    if kw['license'] != nil { package.license = kw['license']; }
    if kw['authors'] != nil { package.authors = kw['authors']; }
    package.setConfigVar('TIMESTAMP', time.format(time.now()));
    return package;
};

"
  Package.requires(name, .kw) -> Dependency
Declares a dependency for this project. Accepts keyword arguments:
  version - version constraint for the required package (default '*')
  feral — true if this is a Feral package dependency (default: false)
The constraint string is validated via version.parseConstraint().
The created Dependency is added to project.dependencies and returned.
"
let requires in Package = fn(name, .kw) {
    let versionConstraint = kw['version'] ?? '*';
    let isFeral = kw['feral'] ?? false;
    let dep = Dependency(name, version.parseConstraint(versionConstraint).str(), isFeral);
    self.dependencies.push(dep);
    return ref(dep);
};

"
  Package.addTarget(.kw, name) -> Target
Declares a native C++ build target for this project.
  name    — target name
  static  - create a static or dynamic binary/library (default: false)
  binary  - create an executable or library (default: true)
The created Target is added to project.targets and returned.
"
let addTarget in Package = fn(.kw, name) {
    let static = kw['static'] ?? false;
    let binary = kw['binary'] ?? false;
    if !binary {
        name = 'libferal' + name;
    }
    let target = Target(name, static, binary);
    self.targets.push(target);
    return ref(target);
};

"
  Package.setConfigVar(name, val) -> Nil
Adds `name` with value as `val` in the config vars map.
Can be used for config substitution in `Str.fmt()` through `Package.applyConfig()`.
"
let setConfigVar in Package = fn(name, val) {
    self.configVars.insert(name, val);
};

"
  Package.addDefinition(name, val = '') -> Nil
Add definitions to be available when compiling the package.
"
let addDefinition in Package = fn(name, val = '') {
    self.definitions.insert(name, Definition(ref(val)));
};

"
  Package.addHeaders(headers...) -> Nil
Add `headers` as dependencies for compilation for all targets.
"
let addHeaders in Target = fn(headers...) {
    self.headers.append(headers);
};

"
  Package.applyConfig(name) -> Var
For the given `name`, returns the equivalent value in `Package.configVars`.
If `name` is not found, returns `nil`.
"
let applyConfig in Package = fn(name) {
    if name == 'PACKAGE_NAME' { return self.name; }
    elif name == 'PACKAGE_DESC' { return self.desc; }
    elif name == 'PACKAGE_VERSION_MAJOR' { return self.version.major; }
    elif name == 'PACKAGE_VERSION_MINOR' { return self.version.minor; }
    elif name == 'PACKAGE_VERSION_PATCH' { return self.version.patch; }
    let v = ref(self.configVars[name]);
    if v != nil { return v; }
    return globalConfigVars[name];
};

"
  Package.addConfigFile(srcPath, destPath) -> Nil
Adds `srcPath` and `destPath` in the list of files to be configured.
The process of configuring considers `srcPath` as a template file, substituting all variables between `$<<` and `>>` in it.
Then it writes the substituted data in `destPath`.
"
let addConfigFile in Package = fn(srcPath, destPath) {
    self.configFiles.insert(srcPath.str(), destPath.str());
};

"
  Package.configureFiles() -> Result<>
Configures all files provided through `Package.addConfigFile()`.
The destination files are added to the header list in the `Package`.
"
let configureFiles in Package = fn() {
    for f in self.configFiles.each() {
        let srcPath = f.0.path();
        let destPath = f.1.path();
        if !fs.exists(srcPath) { return feral.err(-1, 'source path `', srcPath, '` does not exist'); }
        if fs.exists(destPath) && fs.lastWriteTime(destPath) > fs.lastWriteTime(srcPath) { continue; }
        let src = fs.fopen(srcPath, 'r').readAll();
        let dest = src.fmt('$<<', '>>', self.applyConfig);
        let destFile = fs.fopen(destPath, 'w+');
        io.fprint(destFile, dest);
        self.addHeaders(destPath);
    }
    return feral.ok();
};