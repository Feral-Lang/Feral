let map = import('std/map');
let vec = import('std/vec');

################################################################################
# ToolchainInterface Stuff
################################################################################

# Used by ToolchainInterface's implementations
let CompileInfo = struct(
    cmd = vec.new(refs = true),
    dest = ''.path()
);
CompileInfo.setTypeName('CompileInfo');

# Used by ToolchainInterface's implementations
let LinkInfo = struct(
    cmd = vec.new(refs = true),
    dest = ''.path()
);
LinkInfo.setTypeName('LinkInfo');

# ToolchainInterface
let ToolchainInterface = struct();
ToolchainInterface.setTypeName('ToolchainInterface');

let getId in ToolchainInterface = fn() {}; # -> Str
let getEnv in ToolchainInterface = fn() {}; # -> Map<Str>
let getVersion in ToolchainInterface = fn() {}; # -> Str
let getCompileInfo in ToolchainInterface = fn(.kw, destPath, srcs...) {}; # -> Result<CompileInfo>
let getLinkInfo in ToolchainInterface = fn(.kw, destPath, objs...) {}; # -> Result<LinkInfo>

################################################################################
# Utility
################################################################################

# Optimization
let Opt = enum(
    .None, # -O0 -g -DNDEBUG
    .WithDebInfo, # -O2 -g -DNDEBUG
    .Full, # -O3 -DNDEBUG
    .Size, # -Os -DNDEBUG
    .Unknown
);
Opt.setTypeName('Opt');

let getFeralOpt = fn() {
    if feral.buildType == 'Release' {
        return Opt.Full;
    } elif feral.buildType == 'RelWithDebInfo' {
        return Opt.WithDebInfo;
    } elif feral.buildType == 'MinSizeRel' {
        return Opt.Size;
    } else {
        return Opt.None;
    }
};

################################################################################
# LibraryFinder Stuff
################################################################################

let Library = struct(
    name = '',
    version = '',
    includeDirs = vec.new(refs = true),
    libraryDirs = vec.new(refs = true),
    libraryFlags = vec.new(refs = true),
    rpaths = vec.new(refs = true), # Since library dirs are not necessarily same as rpaths, rpaths must be separate.
    definitions = map.new(refs = true), # Name = Value (where value can be empty string)
    dllPaths = vec.new(refs = true), # For Windows
    useLibraryDirsForRPaths = true # if false, library dirs will not be used for rpaths.
);
Library.setTypeName('Library');

let str in Library = fn() {
    let s = 'Library{ name = ' + self.name + '; ';
    if !self.version.empty() { s += 'version = ' + self.version + '; '; }
    if !self.includeDirs.empty() { s += 'includeDirs = ' + self.includeDirs.str() + '; '; }
    if !self.libraryDirs.empty() { s += 'libraryDirs = ' + self.libraryDirs.str() + '; '; }
    if !self.libraryFlags.empty() { s += 'libraryFlags = ' + self.libraryFlags.str() + '; '; }
    if !self.dllPaths.empty() { s += 'dllPaths = ' + self.dllPaths.str() + '; '; }
    s += '}';
    return s;
};

let append in Library = fn(other) {
    for incDir in other.includeDirs.each() {
        self.addIncludeDirs(incDir);
    }
    for libDir in other.libraryDirs.each() {
        self.addLibraryDirs(libDir);
    }
    for libFlag in other.libraryFlags.each() {
        self.addLibraryFlags(libFlag);
    }
    for rpath in other.rpaths.each() {
        self.addRPaths(rpath);
    }
    for d in other.definitions.each() {
        self.addDefinition(d.0, d.1);
    }
    for dllPath in other.dllPaths.each() {
        self.addDllPaths(dllPath);
    }
};

let addIncludeDirs in Library = fn(incDirs...) {
    for incDir in incDirs.each() {
        if self.includeDirs.find(incDir) { continue; }
        self.includeDirs.push(incDir);
    }
};

let addLibraryDirs in Library = fn(libDirs...) {
    for libDir in libDirs.each() {
        if self.libraryDirs.find(libDir) { continue; }
        self.libraryDirs.push(libDir);
    }
};

let addLibraryFlags in Library = fn(libFlags...) {
    for libFlag in libFlags.each() {
        if self.libraryFlags.find(libFlag) { continue; }
        self.libraryFlags.push(libFlag);
    }
};

let addRPaths in Library = fn(rpaths...) {
    for rpath in rpaths.each() {
        if self.rpaths.find(rpath) { continue; }
        self.rpaths.push(rpath);
    }
};

let addDefinitions in Library = fn(.defs) {
    for def in defs.each() {
        if self.definitions.find(def.0) { continue; }
        self.definitions.insert(def.0, def.1.str());
    }
};

let addDefinition in Library = fn(key, val) {
    self.definitions.insert(key, val.str());
};

let addDllPaths in Library = fn(dllPaths...) {
    for dllPath in dllPaths.each() {
        if self.dllPaths.find(dllPath) { continue; }
        self.dllPaths.push(dllPath);
    }
};

let useLibDirsForRPaths in Library = fn(useLibDirs) {
    self.useLibraryDirsForRPaths = useLibDirs;
};