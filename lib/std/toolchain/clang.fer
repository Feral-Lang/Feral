let os = import('std/os');
let map = import('std/map');
let vec = import('std/vec');

let core = import('std/toolchain/core');

let Clang = struct(
    id = 'clang',
    version = '',
    c = ''.path(),
    cxx = ''.path(),
    ar = ''.path()
);
Clang.setTypeName('Clang');

let new = fn() {
    let clangExe = os.findExec('clang');
    let clangxxExe = os.findExec('clang++');
    let arExe = os.findExec('llvm-ar');
    let tc = Clang();
    if clangExe == nil && clangxxExe == nil {
        return feral.err(-1, 'could not find clang/clang++ toolchain in $PATH');
    } elif clangExe == nil {
        return feral.err(-1, 'found clang++ at `', clangxxExe, '`, but could not find clang');
    } elif clangxxExe == nil {
        return feral.err(-1, 'found clang at `', clangExe, '`, but could not find clang++');
    }
    if arExe == nil {
        return feral.err(-1, 'could not find gcc\'s archive utility in $PATH');
    }
    tc.c = clangExe;
    tc.cxx = clangxxExe;
    tc.ar = arExe;
    let out = vec.new(refs = true);
    os.exec(out = out, tc.c, '--version');
    tc.version = out[0].split(' ')[2];
    return feral.ok(tc);
};

let getId in Clang = fn() { return self.id; };
let getEnv in Clang = fn() { return map.new(); };
let getVersion in Clang = fn() { return self.version; };

"
  var.fn(.kw, dest, srcs...) -> Result<core.CompileInfo>
Gets the compilation command for compiling all of `srcs` into `dest` object.
Preferably, use full paths for `dest` and `srcs`.
Takes a bunch of keyword arguments:
* `lang = 'c'/'cxx'` - can provide `c` to compile as a c source.
* `std = <number>` - which standard to use, like `std = 17` or `std = 20`.
* `opt = Opt` - optimization level, one of the values in `Opt` enum.
* `defs = Map` - a map of preprocessor definitions to be provided.
* `flags = Vec<Str>` - a list of flags to be used for compilation.
* `incDirs = Vec<Path>` - a vector of paths to add as include dirs.
* `native = true/false` - if `true`, sets `-march=native` on non-msvc toolchains.
"
let getCompileInfo in Clang = fn(.kw, destPath, srcs...) {
    let lang = kw['lang'];
    let std = kw['std'];
    let opt = kw['opt'];
    let defs = ref(kw['defs']);
    let flags = ref(kw['flags']);
    let incDirs = ref(kw['incDirs']);
    let native = kw['native'];

    # Generate the CompileInfo.

    let info = core.CompileInfo();
    info.dest = (destPath.str() + '.o').path();

    info.cmd.push(lang == 'c' ? self.c : self.cxx);
    info.cmd.push(lang == 'c' ? '-std=c' + std.str() : '-std=c++' + std.str(), '-fPIC', '-c');
    if native { info.cmd.push('-march=native'); }

    # optimization
    if opt == core.Opt.None { info.cmd.push('-O0', '-g'); }
    elif opt == core.Opt.Full { info.cmd.push('-O3'); }
    elif opt == core.Opt.WithDebInfo { info.cmd.push('-O2', '-g'); }
    elif opt == core.Opt.Size { info.cmd.push('-Os'); }
    if opt != core.Opt.None {
        defs.insert('NDEBUG', '');
    }

    info.cmd.append(flags);

    # include dirs
    for incDir in incDirs.each() {
        info.cmd.push('-I' + incDir.str());
    }

    # definitions
    for d in defs.each() {
        let flag = '-D';
        flag += d.0;
        if !d.1._isType_(StrTy) || !d.1.empty() {
            flag += '=' + d.1.str();
        }
        info.cmd.push(flag);
    }

    # sources
    info.cmd.append(srcs);

    # destination
    info.cmd.push('-o', info.dest.str());

    return feral.ok(info);
};

"
  fn(.kw, dest, objs...) -> Result<core.LinkInfo>
Gets the linker command for linking all of `srcs` into `dest`.
Preferably, use full paths for `dest` and `objs`.
Takes a bunch of keyword arguments:
* `lang = 'c'/'cxx'` - Use the respective compiler/linker.
* `opt = Opt` - optimization level, one of the values in `Opt` enum.
* `libDirs = Vec<Path>` - a vector of paths to add as library dirs.
* `libs = Vec<Str>` - a vector of strings to specify libraries to link against.
* `rpaths = Vec<Str>` - a vector of strings to specify rpaths to be added to the generated binary/library.
* `static = true/false` - if `true`, generate static binary/library; dynamic otherwise.
* `binary = true/false` - if `true`, generate an executable; library otherwise.
"
let getLinkInfo in Clang = fn(.kw, destPath, objs...) {
    let lang = kw['lang'];
    let opt = kw['opt'];
    let libDirs = ref(kw['libDirs']);
    let libs = ref(kw['libs']);
    let rpaths = ref(kw['rpaths']);
    let static = kw['static'];
    let binary = kw['binary'];

    let info = core.LinkInfo();
    if binary {
        info.dest = destPath;
    } elif static {
        let libDestFile = destPath.file().str() + '.a';
        info.dest = destPath.parent() / libDestFile;
    } else {
        let libDestFile = destPath.file().str() + '.so';
        info.dest = destPath.parent() / libDestFile;
    }

    if static && !binary {
        info.cmd.push(self.ar, '-rcs');
        info.cmd.push(info.dest.str());
    } else {
        info.cmd.push(lang == 'c' ? self.c : self.cxx);
        info.cmd.push('-o', info.dest.str());
    }

    # sources
    info.cmd.append(objs);

    if binary {
        if static { info.cmd.push('-static'); }
    } else {
        if !static { info.cmd.push('-shared'); }
    }

    if binary || !static {
        # library dirs
        for libDir in libDirs.each() {
            info.cmd.push('-L' + libDir.str());
        }

        # libraries
        for lib in libs.each() {
            info.cmd.push('-l' + lib);
        }

        # rpaths
        for rpath in rpaths.each() {
            info.cmd.push('-Wl,-rpath,' + rpath.str());
        }
    }

    return feral.ok(info);
};