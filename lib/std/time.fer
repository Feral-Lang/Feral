loadlib('std/Time');

"
  fn(newFormat) -> Nil
Sets the default TimePoint.str() and time.parse() format string to `newFormat`.
Returns nil.
"
let setFormat = fn(newFormat) {
    feral.defaultTimeFormat = newFormat;
};

"
  fn(timeStr, formatStr = feral.defaultTimeFormat) -> TimePoint
Parses the time given as `timeStr` using the format given by `formatStr`.
Returns the TimePoint as described by the `timeStr`.
"
let parse = fn(timeStr, formatStr = feral.defaultTimeFormat) {
    return parseNative(timeStr, formatStr);
};
