let io = import('std/io');
let fs = import('std/fs');
let vec = import('std/vec');
let term = import('std/term');
let time = import('std/time');

let Levels = enum(
    .FATAL,
    .WARN,
    .INFO,
    .DEBUG,
    .TRACE
);

# red, yellow, magenta, cyan, green
# param type: Level (int)
let levelColorToStr = fn(lvl) {
    if lvl == Levels.FATAL { return term.red; }
    if lvl == Levels.WARN { return term.yellow; }
    if lvl == Levels.INFO { return term.green; }
    if lvl == Levels.DEBUG { return term.cyan; }
    if lvl == Levels.TRACE { return term.magenta; }
    return '';
};

let levelToStr = fn(lvl) {
    if lvl == Levels.FATAL { return 'FATAL'; }
    if lvl == Levels.WARN { return 'WARN'; }
    if lvl == Levels.INFO { return 'INFO'; }
    if lvl == Levels.DEBUG { return 'DEBUG'; }
    if lvl == Levels.TRACE { return 'TRACE'; }
    return 'INVALID';
};

let FileInfo = struct(
    f = nil,
    level = Levels.WARN,
    prefix = '', # default set using `Logger.addTarget()`
    depthPrefix = '' # default set using `Logger.addTarget()`
);
FileInfo.setTypeName('FileInfo');

####################################################################################################
########################################### Logger #################################################
####################################################################################################

let Logger = struct(
    targets = vec.new(refs = true),
    tagStack = vec.new(),
    depth = 0
);

let newLogger = fn() { return Logger(); };

let addTarget in Logger = fn(.kw, target) {
    let level = kw['level'] ?? Levels.WARN;
    let prefix = kw['prefix'] ?? '[$<<timeStr>>][$<<levelColor>>$<<levelStr>>' + term.reset + ']$<<tag>>: ';
    let depthPrefix = kw['depthPrefix'] ?? '-';
    self.targets.push(FileInfo(ref(target), level, prefix, depthPrefix));
};

let addTargetByPath in Logger = fn(.kw, path) {
    let level = kw['level'] ?? Levels.WARN;
    let prefix = kw['prefix'] ?? '[$<<timeStr>>][$<<levelColor>>$<<levelStr>>' + term.reset + ']$<<tag>>: ';
    let depthPrefix = kw['depthPrefix'] ?? '-';
    let mustClose = kw['close'] ?? true;
    let file = fs.fopen(path, 'w+', mustClose);
    self.targets.push(FileInfo(ref(file), level, prefix, depthPrefix));
};

let log in Logger = fn(lvl, data...) {
    let levelColor = levelColorToStr(lvl);
    let levelStr = levelToStr(lvl);
    let timeStr = time.format(time.now());
    let tag = self.tagStack.empty() ? '' : '[' + self.tagStack.back() + ']';
    for t in self.targets.each() {
        if t.level < lvl { continue; }
        io.fprintln(t.f, t.prefix.fmt(), t.depthPrefix * self.depth, ' ', data...);
    }
};

let pushTag in Logger = fn(tag) { self.tagStack.push(tag); };
let popTag in Logger = fn() { self.tagStack.pop(); };

let pushDepth in Logger = fn() { ++self.depth; };
let popDepth in Logger = fn() { --self.depth; };

let scopedTag in Logger = fn(tag) {
    return ScopedTag(self, tag);
};

let scopedDepth in Logger = fn() {
    return ScopedDepth(self);
};

let fatal in Logger = fn(data...) { return self.log(Levels.FATAL, data...); };
let warn in Logger = fn(data...) { return self.log(Levels.WARN, data...); };
let info in Logger = fn(data...) { return self.log(Levels.INFO, data...); };
let debug in Logger = fn(data...) { return self.log(Levels.DEBUG, data...); };
let trace in Logger = fn(data...) { return self.log(Levels.TRACE, data...); };

let defaultLogger = newLogger();
defaultLogger.addTarget(io.stderr, prefix = '');

let fatal = fn(data...) { defaultLogger.fatal(data...); };
let warn = fn(data...) { defaultLogger.warn(data...); };
let info = fn(data...) { defaultLogger.info(data...); };
let debug = fn(data...) { defaultLogger.debug(data...); };
let trace = fn(data...) { defaultLogger.trace(data...); };

####################################################################################################
######################################### Utilities ################################################
####################################################################################################

let ScopedTag = struct(logger = nil, tag = '');
let _init_ in ScopedTag = fn() { self.logger.pushTag(self.tag); };
let _deinit_ in ScopedTag = fn() { self.logger.popTag(); };

let ScopedDepth = struct(logger = nil);
let _init_ in ScopedDepth = fn() { self.logger.pushDepth(); };
let _deinit_ in ScopedDepth = fn() { self.logger.popDepth(); };
