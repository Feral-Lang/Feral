let fs = import('std/fs');
let os = import('std/os');
let vec = import('std/vec');
let package = import('std/package');
let version = import('std/version');
let toolchainCore = import('std/toolchain/core');

let FeralFinder = struct();
FeralFinder.setTypeName('FeralFinder');

let new = fn() {
    return feral.ok(FeralFinder());
};

let findLibrary in FeralFinder = fn(pkgName, .kw) {
    let versConstraint = version.parseConstraint(kw['version'] ?? '*');
    let isFeral = kw['feral'] ?? true;
    if !isFeral { return feral.err(-1, 'FeralFinder cannot be used to find non-Feral libraries'); }
    let pkgInstallPrefix = package.getInstallPath(pkgName, '').str();
    let installedPkgDirs = fs.walkDir(package.installRoot, fs.WALK_DIRS, '(.*)' + pkgName.lower() + '(.*)');
    let installedVersions = vec.new(refs = true);
    for d in installedPkgDirs.each() {
        installedVersions.push(version.parse(d.str().replace(pkgInstallPrefix, '')));
    }
    installedVersions.sort(rev = true);
    if installedVersions.empty() {
        return feral.err(-1, 'no version of `', pkgName, '` is installed');
    }
    let viableVersion = '';
    for v in installedVersions.each() {
        if versConstraint.matches(v) { viableVersion = v.str(); break; }
    }
    if viableVersion.empty() {
        return feral.err(-1, 'no viable version of `', pkgName, '` is installed that satisfies constraint `', versConstraint, '`');
    }
    let installDir = package.getInstallPath(pkgName, viableVersion);

    let lib = toolchainCore.Library(pkgName, viableVersion);

    let headers = fs.walkDir(installDir, fs.WALK_RECURSE, '(.*).hpp');
    if !headers.empty() {
        for h in headers.each() {
            lib.addIncludeDirs(h.parent());
        }
    }
    let libFiles = fs.walkDir(installDir, fs.WALK_RECURSE, '(.*).lib|(.*).so|(.*).dylib|(.*).dll');
    for f in libFiles.each() {
        lib.addLibraryDirs(f.parent());
        if f.str().endsWith('.dll') {
            lib.addDllPaths(f);
            continue;
        }
        if os.name == 'windows' {
            lib.addLibraryFlags(f.fileName().str());
        } else {
            lib.addLibraryFlags(f.fileName().str().replace('lib', ''));
        }
    }
    return feral.ok(lib);
};