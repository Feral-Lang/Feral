let fs = import('std/fs');
let os = import('std/os');
let map = import('std/map');
let vec = import('std/vec');
let version = import('std/version');
let toolchainCore = import('std/toolchain/core');

let VCPKGFinder = struct(
    root = ''.path()
);
VCPKGFinder.setTypeName('VCPKGFinder');

let new = fn() {
    if os.name != 'windows' { return feral.err(-1, 'Only usable on Windows'); }

    let exe = os.findExec('vcpkg.exe');
    let vcpkgRoot = ''.path();
    if exe == nil {
        let tmp = os.getEnv('VCPKG_ROOT');
        if tmp == nil { return feral.err(-1, 'No `VCPKG_ROOT` environment variable set'); }
        vcpkgRoot = tmp.path();
        if !fs.exists(vcpkgRoot / 'vcpkg.exe') { feral.err(-1, 'Could not find vcpkg.exe'); }
    } else {
        vcpkgRoot = exe.parent();
    }

    return feral.ok(VCPKGFinder(vcpkgRoot));
};

let findLibrary in VCPKGFinder = fn(pkgNameTmp, .kw) {
    let isDebug = kw['debug'] ?? false;
    let versConstraint = kw['version'] ?? '*';
    let isFeral = kw['feral'] ?? false;
    if isFeral { return feral.err(-1, 'VCPKGFinder cannot be used to find Feral libraries'); }

    let pkgName = pkgNameTmp.lower();

    let portsPath = self.root / 'ports';

    if !fs.exists(portsPath / pkgName) {
        return feral.err(-1, 'Library ', pkgName, ' does not exist in vcpkg');
    }

    let installRoot = self.root / 'installed' / 'x64-windows';

    let sharePath = installRoot / 'share';

    if !fs.exists(sharePath / pkgName) {
        return feral.err(-1, 'Library ', pkgName, ' is not installed via vcpkg');
    }

    let exe = self.root / 'vcpkg.exe';

    # Export the library using vcpkg to a temp folder.
    let tempRoot = feral.tempPath / 'libfinder' / 'vcpkg';
    let pkgTempRoot = tempRoot / pkgName;
    let out = vec.new(refs = true);
    let res = os.exec(out = out, exe, 'export', '--raw', pkgName, '--output-dir', tempRoot, '--output', pkgName);
    if res != 0 {
        return feral.err(-1, 'Failed to export package ', pkgName, ' using `vcpkg export`:\n', out.join('\n'));
    }

    # Now, setup the library information.
    let pkgTempInstallRoot = pkgTempRoot / 'installed' / 'x64-windows';
    let pkgInstallRoot = self.root / 'installed' / 'x64-windows';
    inline if isDebug {
        let tempBinPath = pkgTempInstallRoot / 'debug' / 'bin';
        let tempLibPath = pkgTempInstallRoot / 'debug' / 'lib';
        let binPath = pkgInstallRoot / 'debug' / 'bin';
        let libPath = pkgInstallRoot / 'debug' / 'lib';
    } else {
        let tempBinPath = pkgTempInstallRoot / 'bin';
        let tempLibPath = pkgTempInstallRoot / 'lib';
        let binPath = pkgInstallRoot / 'bin';
        let libPath = pkgInstallRoot / 'lib';
    }

    let lib = toolchainCore.Library(pkgName);
    lib.addIncludeDirs(pkgInstallRoot / 'include');
    lib.addLibraryDirs(libPath);

    let dlls = fs.walkDir(tempBinPath, fs.WALK_FILES, '(.*).dll|(.*).pdb');
    for dll in dlls.each() {
        lib.addDllPaths(binPath / dll.file());
    }

    let libs = fs.walkDir(tempLibPath, fs.WALK_FILES, '(.*).lib');
    for l in libs.each() {
        lib.addLibraryFlags(l.file());
    }

    # Remove the `vcpkg export` directory.
    fs.remove(pkgTempInstallRoot);

    # Get the library version.
    let out = vec.new(refs = true);
    let res = os.exec(out = out, exe, 'list', pkgName, '^2>&1');
    if res != 0 {
        return feral.err(-1, 'Failed to get version info for library ', pkgName, ' using vcpkg');
    }
    for o in out.each() {
        let split = o.split('  ', -1, true);
        if split.len() < 3 { continue; }
        lib.version = split[1].trim();
    }

    return feral.ok(lib);
};