FERAL_FUNC(strClear, 0, false,
           "  var.fn() -> Nil\n"
           "Clears out the string `var`.")
{
    as<VarStr>(args[0])->clear();
    return vm.getNil();
}

FERAL_FUNC(strEmpty, 0, false,
           "  var.fn() -> Bool\n"
           "Returns `true` if the string `var` doesn't contain any characters / is empty.")
{ return as<VarStr>(args[0])->getVal().size() == 0 ? vm.getTrue() : vm.getFalse(); }

FERAL_FUNC(strFront, 0, false,
           "  var.fn() -> Str | Nil\n"
           "Returns the first character in the string `var` or `nil` if `var` is empty.")
{
    StringRef str = as<VarStr>(args[0])->getVal();
    return str.size() == 0 ? (Var *)vm.getNil() : (Var *)vm.makeVar<VarStr>(loc, str.front());
}

FERAL_FUNC(strBack, 0, false,
           "  var.fn() -> Str | Nil\n"
           "Returns the last character in the string `var` or `nil` if `var` is empty.")
{
    StringRef str = as<VarStr>(args[0])->getVal();
    return str.size() == 0 ? (Var *)vm.getNil() : (Var *)vm.makeVar<VarStr>(loc, str.back());
}

FERAL_FUNC(strPush, 1, false,
           "  var.fn(source) -> var\n"
           "Appends the `source` string into `var` and returns the updated `var`.")
{
    EXPECT_NO_CONST(args[0], "var");
    EXPECT(VarStr, args[1], "source string");
    as<VarStr>(args[0])->append(as<VarStr>(args[1])->getVal());
    return args[0];
}

FERAL_FUNC(strPop, 0, false,
           "  var.fn() -> var\n"
           "Pops the last character from the string `var` if `var` is not empty, and returns the "
           "updated `var`.")
{
    EXPECT_NO_CONST(args[0], "var");
    as<VarStr>(args[0])->pop();
    return args[0];
}

FERAL_FUNC(strIsChAt, 2, false,
           "  var.fn(position, char) -> Bool\n"
           "Returns `true` if `var` contains `char` at index `position`.")
{
    EXPECT(VarInt, args[1], "index in string");
    EXPECT2(VarStr, VarInt, args[2], "comparison character");
    size_t pos    = as<VarInt>(args[1])->getVal();
    StringRef src = as<VarStr>(args[0])->getVal();
    if(pos >= src.size()) return vm.getFalse();
    if(args[2]->is<VarInt>()) {
        char c = as<VarInt>(args[2])->getVal();
        return src[pos] == c ? vm.getTrue() : vm.getFalse();
    }
    StringRef chars = as<VarStr>(args[2])->getVal();
    return chars.find(src[pos]) == String::npos ? vm.getFalse() : vm.getTrue();
}

FERAL_FUNC(strSetAt, 2, false,
           "  var.fn(position, char) -> var\n"
           "Sets `char` at index `position` in `var` and returns the updated `var`.")
{
    EXPECT_NO_CONST(args[0], "var");
    EXPECT(VarInt, args[1], "index in string");
    EXPECT(VarStr, args[2], "insertion character");
    size_t pos   = as<VarInt>(args[1])->getVal();
    VarStr *dest = as<VarStr>(args[0]);
    if(pos >= dest->length()) {
        vm.fail(loc, "position ", pos, " is not within string of length: ", dest->length());
        return nullptr;
    }
    StringRef src = as<VarStr>(args[2])->getVal();
    if(!src.empty()) dest->data()[pos] = src[0];
    return args[0];
}

FERAL_FUNC(strInsert, 2, false,
           "  var.fn(position, data) -> Bool\n"
           "Inserts `data` at index `position` in `var` and returns the updated `var`.")
{
    EXPECT_NO_CONST(args[0], "var");
    EXPECT(VarInt, args[1], "index in string");
    EXPECT(VarStr, args[2], "insertion string");
    size_t pos   = as<VarInt>(args[1])->getVal();
    VarStr *dest = as<VarStr>(args[0]);
    if(pos > dest->length()) {
        vm.fail(loc, "position ", pos, " is greater than string length: ", dest->length());
        return nullptr;
    }
    StringRef src = as<VarStr>(args[2])->getVal();
    dest->insert(pos, src);
    return args[0];
}

FERAL_FUNC(strErase, 1, true,
           "  var.fn(position, count = 1) -> var\n"
           "Erases the characters in string `var` starting at (and including) `position`, up until "
           "`count` characters.\n"
           "If `count` is `-1` or more than the length of the string, the remainder of the string "
           "is erased.\n"
           "Returns the updated `var`.")
{
    EXPECT_NO_CONST(args[0], "var");
    EXPECT(VarInt, args[1], "index in string");
    VarStr *str  = as<VarStr>(args[0]);
    size_t pos   = as<VarInt>(args[1])->getVal();
    size_t count = 1;
    if(args.size() > 2) {
        EXPECT(VarInt, args[2], "number of characters to remove");
        count = as<VarInt>(args[2])->getVal();
    }
    str->erase(pos, count);
    return args[0];
}

FERAL_FUNC(strAppend, 1, true,
           "  var.fn(data...) -> Nil\n"
           "Removes the char at index `position` in `var`.\n"
           "Returns `nil`.")
{
    EXPECT_NO_CONST(args[0], "var");
    VarStr *self = as<VarStr>(args[0]);
    for(size_t i = 1; i < args.size(); ++i) {
        if(args[i]->is<VarStr>()) {
            self->append(as<VarStr>(args[i])->getVal());
            continue;
        }
        Var *argStr = nullptr;
        Array<Var *, 1> strArgs{args[i]};
        bool res = vm.callVarAndExpect<VarStr>(loc, "str", argStr, strArgs, nullptr);
        if(!res) {
            vm.fail(loc, "failed to call `str()` on argument at index `", i - 1,
                    "` of type: ", vm.getTypeName(args[i]));
            return nullptr;
        }
        self->append(as<VarStr>(argStr)->getVal());
        vm.decVarRef(argStr);
    }
    return vm.getNil();
}

FERAL_FUNC(strFind, 1, false,
           "  var.fn(data) -> Int\n"
           "Returns the position / index of the first occurrence of `data` in `var`. If it's not "
           "found, returns -1.")
{
    EXPECT(VarStr, args[1], "search string");
    StringRef str  = as<VarStr>(args[0])->getVal();
    StringRef what = as<VarStr>(args[1])->getVal();
    size_t pos     = str.find(what);
    if(pos == String::npos) { return vm.makeVar<VarInt>(loc, -1); }
    return vm.makeVar<VarInt>(loc, pos);
}

FERAL_FUNC(strRFind, 1, false,
           "  var.fn(data) -> Int\n"
           "Returns the position / index of the last occurrence of `data` in `var`. If it's not "
           "found, returns -1.")
{
    EXPECT(VarStr, args[1], "search string");
    StringRef str  = as<VarStr>(args[0])->getVal();
    StringRef what = as<VarStr>(args[1])->getVal();
    size_t pos     = str.rfind(what);
    if(pos == String::npos) { return vm.makeVar<VarInt>(loc, -1); }
    return vm.makeVar<VarInt>(loc, pos);
}

FERAL_FUNC(strSubstrNative, 2, false, "")
{
    EXPECT(VarInt, args[1], "start position");
    EXPECT(VarInt, args[2], "number of characters");
    size_t pos    = as<VarInt>(args[1])->getVal();
    size_t len    = as<VarInt>(args[2])->getVal();
    StringRef str = as<VarStr>(args[0])->getVal();
    return vm.makeVar<VarStr>(loc, str.substr(pos, len));
}

FERAL_FUNC(strTrim, 0, false,
           "  var.fn() -> var\n"
           "Trims the string `var` - removing any space/tab/newline characters from the beginning "
           "and the end of the string, and returns the updated `var`.")
{
    VarStr *str = as<VarStr>(args[0]);
    str->trim();
    return args[0];
}

FERAL_FUNC(strLower, 0, false,
           "  var.fn() -> Str\n"
           "Converts all the upper case charcters in the string `var` to lower case and returns "
           "that as a new string.")
{
    VarStr *res = vm.makeVar<VarStr>(loc, as<VarStr>(args[0])->getVal());
    char *str   = res->data();
    size_t len  = res->length();
    for(size_t i = 0; i < len; ++i) {
        str[i] = str[i] >= 'A' && str[i] <= 'Z' ? str[i] | 0x60 : str[i];
    }
    return res;
}

FERAL_FUNC(strUpper, 0, false,
           "  var.fn() -> Str\n"
           "Converts all the lower case charcters in the string `var` to upper case and returns "
           "that as a new string.")
{
    VarStr *res = vm.makeVar<VarStr>(loc, as<VarStr>(args[0])->getVal());
    char *str   = res->data();
    size_t len  = res->length();
    for(size_t i = 0; i < len; ++i) {
        str[i] = str[i] >= 'a' && str[i] <= 'z' ? str[i] ^ 0x20 : str[i];
    }
    return res;
}

FERAL_FUNC(strSplitNative, 3, false, "")
{
    EXPECT(VarStr, args[1], "delimiter");
    EXPECT(VarInt, args[2], "delimit count");
    EXPECT(VarBool, args[3], "ignore empty splits");
    StringRef str    = as<VarStr>(args[0])->getVal();
    StringRef delim  = as<VarStr>(args[1])->getVal();
    bool ignoreEmpty = as<VarBool>(args[3])->getVal();
    if(delim.size() == 0) {
        vm.fail(loc, "found empty delimiter for string split");
        return nullptr;
    }
    int64_t _maxDelimCount = as<VarInt>(args[2])->getVal();
    // Not using std::numeric_limits<uint64_t>().max() as `max` conflicts with a macro of same name
    // on Windows.
    uint64_t maxDelimCount = _maxDelimCount >= 0 ? _maxDelimCount : UINT64_MAX;

    VarVec *res = vm.makeVar<VarVec>(loc, 0, false);
    if(str.empty()) return res;

    size_t start      = 0;
    size_t end        = str.find(delim);
    size_t delimCount = 0;
    while(end != String::npos && delimCount++ < maxDelimCount) {
        StringRef tmp(str.substr(start, end - start));
        while(!tmp.empty() && tmp.front() == ' ') tmp = StringRef(tmp.data() + 1, tmp.length() - 1);
        while(!tmp.empty() && tmp.back() == ' ') tmp = StringRef(tmp.data(), tmp.length() - 1);
        if(!tmp.empty() || !ignoreEmpty) res->push(vm, vm.makeVar<VarStr>(loc, tmp), true);
        start = end + delim.length();
        end   = str.find(delim, start);
    }
    StringRef tmp(str.substr(start, end - start));
    while(!tmp.empty() && tmp.front() == ' ') tmp = StringRef(tmp.data() + 1, tmp.length() - 1);
    while(!tmp.empty() && tmp.back() == ' ') tmp = StringRef(tmp.data(), tmp.length() - 1);
    if(!tmp.empty() || !ignoreEmpty) res->push(vm, vm.makeVar<VarStr>(loc, tmp), true);

    return res;
}

FERAL_FUNC(strStartsWith, 1, true,
           "  var.fn(strs...) -> Bool\n"
           "Returns `true` if the string `var` starts with any of `strs`.")
{
    StringRef str = as<VarStr>(args[0])->getVal();
    for(size_t i = 1; i < args.size(); ++i) {
        EXPECT(VarStr, args[i], "compare string");
        StringRef with = as<VarStr>(args[i])->getVal();
        if(str.rfind(with, 0) == 0) return vm.getTrue();
    }
    return vm.getFalse();
}

FERAL_FUNC(strEndsWith, 1, true,
           "  var.fn(strs...) -> Bool\n"
           "Returns `true` if the string `var` ends with any of `strs`.")
{
    StringRef str = as<VarStr>(args[0])->getVal();
    for(size_t i = 1; i < args.size(); ++i) {
        EXPECT(VarStr, args[i], "compare string");
        StringRef with = as<VarStr>(args[i])->getVal();
        size_t pos     = str.rfind(with);
        if(pos != String::npos && pos + with.size() == str.size()) return vm.getTrue();
    }
    return vm.getFalse();
}

FERAL_FUNC(strFit, 1, false,
           "  var.fn(count) -> Str\n"
           "Fits the string `var` in `count` characters.\n"
           "If `var.len()` exceeds `count`, any excess + 3 characters will be trimmed off and a "
           "`...` will be appended.\n"
           "Otherwise, all remaining characters will be filled with `fillChar`.\n"
           "The alignment will be based on `align` parameter.\n"
           "Takes the following keyword parameters:\n"
           "* `fillChar = ' '` - char to fill `var.len() - count` characters. (default: ' ')\n"
           "* `align = 0/1/2` - 0: left; 1: center; 2: right. (default: 2)")
{
    EXPECT(VarInt, args[1], "max char count");
    int64_t count = as<VarInt>(args[1])->getVal();
    char fillChar = ' ';
    int align     = 2;
    if(Var *fillCharVar = assnArgs->getAttr("fillChar")) {
        EXPECT(VarStr, fillCharVar, "fill character");
        StringRef fillCharStr = as<VarStr>(fillCharVar)->getVal();
        if(fillCharStr.empty()) {
            vm.fail(loc, "provided fill character is empty");
            return nullptr;
        }
        fillChar = fillCharStr[0];
    }
    if(Var *alignVar = assnArgs->getAttr("align")) {
        EXPECT(VarInt, alignVar, "alignment (0/1/2)");
        align = as<VarInt>(alignVar)->getVal();
    }
    VarStr *resVar = vm.makeVar<VarStr>(loc, as<VarStr>(args[0])->getVal());
    char *res      = resVar->data();
    if(resVar->length() > count) {
        if(count >= 3) {
            res[count - 3] = '.';
            res[count - 2] = '.';
            res[count - 1] = '.';
            resVar->setLength(count); // also sets '\0'
        } else {
            resVar->erase(2);
        }
    } else if(resVar->length() < count) {
        resVar->reserve(count, false, false);
        if(align == 0) { // left align
            while(resVar->length() < count) resVar->append(fillChar);
        } else if(align == 1) {
            bool left = true;
            while(resVar->length() < count) {
                if(left) resVar->append(fillChar);
                else resVar->insert(0, fillChar);
                left = !left;
            }
        } else if(align == 2) {
            while(resVar->length() < count) resVar->insert(0, fillChar);
        }
    }
    return resVar;
}

FERAL_FUNC(strFormat, 0, true,
           "  var.fn(start = '$<<', end = '>>', callback = feral.evalExpr) -> Str\n"
           "Uses `var` as a template and replaces variables in it by calling `callback` and using "
           "its return value.\n"
           "The variables should be enclosed in `start` and `end` in `data` to be substituted.\n"
           "The substitution is ignored if `start` is preceded by `\\` in `data`.\n"
           "Optionally takes `nofail = false` as an argument which makes it fail if the "
           "returned value from callback is empty/invalid.")
{
    String result{as<VarStr>(args[0])->getVal()};
    StringRef start = "$<<";
    StringRef end   = ">>";
    bool noFail     = true;
    Var *cb         = nullptr;

    if(args.size() > 1) {
        EXPECT(VarStr, args[1], "start enclosure");
        start = as<VarStr>(args[1])->getVal();
        if(start.empty()) {
            vm.fail(loc, "`start` cannot be an empty string");
            return nullptr;
        }
    }
    if(args.size() > 2) {
        EXPECT(VarStr, args[2], "end enclosure");
        end = as<VarStr>(args[2])->getVal();
        if(end.empty()) {
            vm.fail(loc, "`end` cannot be an empty string");
            return nullptr;
        }
    }
    if(args.size() > 3) {
        if(!args[3]->isCallable()) {
            vm.fail(loc,
                    "expected a callable as format function, found: ", vm.getTypeName(args[3]));
            return nullptr;
        }
        cb = args[3];
    }
    if(Var *noFailVar = assnArgs->getAttr("nofail")) {
        EXPECT(VarBool, noFailVar, "nofail value");
        noFail = as<VarBool>(noFailVar)->getVal();
    }

    for(size_t i = 0; i < result.size(); ++i) {
        if(result[i] != start[0]) continue;
        if(i != 0 && result[i - 1] == '\\') {
            result.erase(i - 1, 1);
            --i;
            continue;
        }
        StringRef tmp(result.begin() + i, result.end());
        if(!tmp.starts_with(start)) continue;
        result.erase(i, start.size());
        size_t endidx = i;
        bool found    = false;
        while(endidx < result.size()) {
            if(result[endidx] != end[0]) {
                ++endidx;
                continue;
            }
            StringRef tmpEnd(result.begin() + endidx, result.end());
            if(!tmpEnd.starts_with(end)) {
                ++endidx;
                continue;
            }
            result.erase(endidx, end.size());
            found = true;
            break;
        }
        if(!found) {
            vm.fail(loc, "Failed to find the end tag: `", end, "` in data");
            return nullptr;
        }
        if(i == endidx) continue;
        StringRef varStr(result.begin() + i, result.begin() + endidx);
        VarStr *var = vm.makeVar<VarStr>(loc, varStr);
        Array<Var *, 2> cbArgs{nullptr, vm.incVarRef(var)};
        Var *subs = cb ? vm.callVar(loc, "formatCallback", cb, cbArgs, nullptr)
                       : vm.eval(loc, varStr, true);
        vm.decVarRef(var);
        if(!subs) {
            vm.fail(loc, "failed to call the format callback");
            return nullptr;
        }
        if(!subs->is<VarStr>() && !subs->is<VarNil>()) {
            Var *subsStr = nullptr;
            Array<Var *, 1> strArgs{subs};
            bool strRes = vm.callVarAndExpect<VarStr>(loc, "str", subsStr, strArgs, nullptr);
            vm.decVarRef(subs);
            if(!strRes) return nullptr;
            subs = subsStr;
        }
        StringRef val = "";
        if(subs->is<VarStr>()) val = as<VarStr>(subs)->getVal();
        if(val.empty() && !noFail) {
            vm.fail(loc, "couldn't find a value after substitution for string: `", varStr, "`.");
            vm.decVarRef(subs);
            return nullptr;
        }
        result.replace(i, endidx - i, val);
        --i;
        vm.decVarRef(subs);
    }
    return vm.makeVar<VarStr>(loc, result);
}

// character (str[0]) to its ASCII (int)
FERAL_FUNC(byt, 0, false,
           "  var.fn() -> Int\n"
           "Returns the first character (byte) in the string `var` as an integer.")
{
    StringRef str = as<VarStr>(args[0])->getVal();
    if(str.empty()) return vm.makeVar<VarInt>(loc, 0);
    return vm.makeVar<VarInt>(loc, (unsigned char)str[0]);
}

// ASCII (int) to character (str)
FERAL_FUNC(chr, 0, false,
           "  var.fn() -> Str\n"
           "Converts the integer `var` (1 byte) into a character and returns it as a string.")
{
    char byt = (char)as<VarInt>(args[0])->getVal();
    return vm.makeVar<VarStr>(loc, byt);
}

FERAL_FUNC(strReplace, 2, false,
           "  var.fn(from, to) -> Str\n"
           "Replaces `from` with `to` in string `var` and returns the resulting string.")
{
    EXPECT(VarStr, args[1], "replace from");
    EXPECT(VarStr, args[2], "replace to");
    StringRef from = as<VarStr>(args[1])->getVal();
    StringRef to   = as<VarStr>(args[2])->getVal();
    VarStr *res    = vm.makeVar<VarStr>(loc, as<VarStr>(args[0])->getVal());
    res->replace(from, to);
    return res;
}

FERAL_FUNC(strToPath, 0, false,
           "  var.fn() -> Path\n"
           "Creates a Path instance using `var` and returns it.")
{ return vm.makeVar<VarPath>(loc, StringRef(as<VarStr>(args[0])->getVal())); }

// trim from start (in place)
static inline void ltrim(String &s)
{
    s.erase(s.begin(), std::find_if(s.begin(), s.end(), [](int ch) { return !std::isspace(ch); }));
}

// trim from end (in place)
static inline void rtrim(String &s)
{
    s.erase(std::find_if(s.rbegin(), s.rend(), [](int ch) { return !std::isspace(ch); }).base(),
            s.end());
}

// trim from both ends (in place)
static inline void trim(String &s)
{
    ltrim(s);
    rtrim(s);
}

size_t sizePow(size_t base, int exp)
{
    size_t result = 1;
    while(exp) {
        if(exp % 2) result *= base;
        exp /= 2;
        base *= base;
    }
    return result;
}

size_t strToBin(StringRef str)
{
    size_t exp = sizePow(2, str.size() - 1);
    size_t bin = 0;
    for(auto &c : str) {
        if(c == '1') { bin += exp; }
        exp /= 2;
    }
    return bin;
}

} // namespace fer