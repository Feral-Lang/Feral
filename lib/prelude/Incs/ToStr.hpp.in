#include "VM/VM.hpp"

namespace fer
{

FERAL_FUNC(allToStr, 0, false,
           "  var.fn() -> Str\n"
           "Returns the type name and memory address of `var`.\n"
           "This function is used as a default if a type doesn't implement its own `.str()` member "
           "function.")
{
    char tmp[24];
    snprintf(tmp, sizeof(tmp) / sizeof(tmp[0]), "%p", args[0]);
    VarStr *res = vm.makeVar<VarStr>(loc, "");
    res->setVal({"Type: ", vm.getTypeName(args[0]), " at ", tmp});
    return res;
}

FERAL_FUNC(bytebufferToStr, 0, false,
           "  var.fn() -> Str\n"
           "Converts the bytes in the Bytebuffer `var` into a string and returns it.")
{
    VarBytebuffer *self = as<VarBytebuffer>(args[0]);
    if(self->size() == 0) return vm.makeVar<VarStr>(loc, "");
    return vm.makeVar<VarStr>(loc, reinterpret_cast<const char *>(self->getVal()), self->size());
}

FERAL_FUNC(nilToStr, 0, false,
           "  var.fn() -> Str\n"
           "Returns `'(nil)'`.")
{ return vm.makeVar<VarStr>(loc, "(nil)"); }

FERAL_FUNC(boolToStr, 0, false,
           "  var.fn() -> Str\n"
           "Returns `'true'` if `var` is `true`, `'false'` otherwise.")
{ return vm.makeVar<VarStr>(loc, as<VarBool>(args[0])->getVal() ? "true" : "false"); }

FERAL_FUNC(typeIDToStr, 0, false,
           "  var.fn() -> Str\n"
           "Returns the string representation of the typeID `var` with the ID as `number` as "
           "`'typeid<number>'`.")
{
    char tmp[24];
    snprintf(tmp, sizeof(tmp) / sizeof(tmp[0]), "%ld", as<VarTypeID>(args[0])->getVal());
    VarStr *res = vm.makeVar<VarStr>(loc, "");
    res->setVal({"typeid<", tmp, ">"});
    return res;
}

FERAL_FUNC(intToStr, 0, false,
           "  var.fn(.kw) -> Str\n"
           "Converts the int `var` into a string and returns it.\n"
           "Takes the following optional arguments:\n"
           "* `base = <int>` - base for the number `var`. (default: 10)")
{
    char fmt[256] = {0};
    int base      = 10;
    if(assnArgs) {
        if(Var *baseVar = assnArgs->getAttr("precision")) {
            EXPECT(VarInt, baseVar, "base");
            base = as<VarInt>(baseVar)->getVal();
        }
    }
    auto res = std::to_chars(fmt, fmt + 256, as<VarInt>(args[0])->getVal(), base);
    if(res.ec != std::errc()) {
        vm.fail(loc, "failed to convert int to string: ", std::make_error_code(res.ec).message());
        return nullptr;
    }
    return vm.makeVar<VarStr>(loc, fmt);
}

FERAL_FUNC(fltToStr, 0, false,
           "  var.fn(precision = 2) -> Str\n"
           "Converts the float `var` into a string and returns it.\n"
           "Takes the following optional arguments:\n"
           "* `precision = <int>` - number of precision digits. (default: 2)")
{
    char fmt[32]  = {0};
    int precision = 2;
    if(assnArgs) {
        if(Var *precisionVar = assnArgs->getAttr("precision")) {
            EXPECT(VarInt, precisionVar, "precision");
            precision = as<VarInt>(precisionVar)->getVal();
        }
    }
    if(precision > 24) {
        vm.fail(loc, "floating precision cannot be more than 24, found: ", precision);
        return nullptr;
    }
    auto res = std::to_chars(fmt, fmt + 32, as<VarFlt>(args[0])->getVal(), std::chars_format::fixed,
                             precision);
    if(res.ec != std::errc()) {
        vm.fail(loc, "failed to convert float to string: ", std::make_error_code(res.ec).message());
        return nullptr;
    }
    return vm.makeVar<VarStr>(loc, fmt);
}

FERAL_FUNC(strToStr, 0, false,
           "  var.fn() -> var\n"
           "Returns `var` as is.")
{ return args[0]; }

FERAL_FUNC(failureToStr, 0, false,
           "  var.fn() -> Str\n"
           "Returns the message in the failure `var`.")
{ return vm.makeVar<VarStr>(loc, as<VarFailure>(args[0])->getMsg()); }

FERAL_FUNC(pathToStr, 0, false,
           "  var.fn() -> Str\n"
           "Converts the path `var` into a string and returns it.")
{ return vm.makeVar<VarStr>(loc, as<VarPath>(args[0])->toStr()); }

FERAL_FUNC(structToStr, 0, false,
           "  var.fn() -> Str\n"
           "Returns a string representation of all the fields and their respective values in the "
           "struct `var`.\n"
           "Each of the fields' values have their `.str()` member function invoked to get their "
           "string representation.")
{
    VarStruct *st = as<VarStruct>(args[0]);
    VarStr *res   = vm.makeVar<VarStr>(loc, vm.getTypeName(st->getSubType()));
    res->append("{");
    for(auto it = st->attrBegin(); it != st->attrEnd(); st->attrNext(it)) {
        Var *v = nullptr;
        Array<Var *, 1> tmp{it.val()};
        if(!vm.callVarAndExpect<VarStr>(loc, "str", v, tmp, {})) {
            vm.decVarRef(res);
            return nullptr;
        }
        res->append({it.key(), ": ", as<VarStr>(v)->getVal()});
        vm.decVarRef(v);
        res->append(", ");
    }
    if(st->getAttrCount() > 0) {
        res->pop();
        res->pop();
    }
    res->append("}");
    return res;
}

FERAL_FUNC(errorToStr, 0, false,
           "  var.fn() -> Str\n"
           "Returns the string representation of the error `var`.")
{
    VarError *e = as<VarError>(args[0]);
    char tmp[32];
    sprintf(tmp, "%ld", e->getCode());
    VarStr *res = vm.makeVar<VarStr>(loc, "");
    res->setVal({"Error<", tmp, ": ", e->getMsg(), ">"});
    return res;
}

FERAL_FUNC(resultToStr, 0, false,
           "  var.fn() -> Str\n"
           "Returns the string representation of the Result `var`.")
{
    VarResult *r = as<VarResult>(args[0]);
    Var *v       = nullptr;
    Array<Var *, 1> tmp{r->getVal()};
    if(!vm.callVarAndExpect<VarStr>(loc, "str", v, tmp, {})) return nullptr;
    VarStr *res = vm.makeVar<VarStr>(loc, "");
    res->setVal({"Result.", r->isOk() ? "Ok" : "Err", "<", as<VarStr>(v)->getVal(), ">"});
    vm.decVarRef(v);
    return res;
}

} // namespace fer

