#include "VM/VM.hpp"

namespace fer
{

FERAL_FUNC(bytebufferNew, 1, false,
           "  fn(size) -> Bytebuffer\n"
           "Creates and returns a Bytebuffer with `size` bytes reserved.")
{
    EXPECT(VarInt, args[1], "bytebuffer size");
    return vm.makeVar<VarBytebuffer>(loc, as<VarInt>(args[1])->getVal());
}

FERAL_FUNC(bytebufferEQ, 1, false,
           "  var.fn(other) -> Bool\n"
           "Returns `true` if `var` and `other` represent same bytebuffers.")
{
    if(!args[1]->is<VarBytebuffer>()) return vm.getFalse();
    VarBytebuffer *lhs = as<VarBytebuffer>(args[0]);
    VarBytebuffer *rhs = as<VarBytebuffer>(args[1]);
    if(lhs->size() != rhs->size()) return vm.getFalse();
    return memcmp(lhs->getVal(), rhs->getVal(), lhs->size()) == 0 ? vm.getTrue() : vm.getFalse();
}

FERAL_FUNC(bytebufferNE, 1, false,
           "  var.fn(other) -> Bool\n"
           "Returns `true` if `var` and `other` are of different types or if"
           " the bytebuffers `var` and `other` are not same.")
{
    if(!args[1]->is<VarBytebuffer>()) return vm.getTrue();
    VarBytebuffer *lhs = as<VarBytebuffer>(args[0]);
    VarBytebuffer *rhs = as<VarBytebuffer>(args[1]);
    if(lhs->size() != rhs->size()) return vm.getTrue();
    return memcmp(lhs->getVal(), rhs->getVal(), lhs->size()) != 0 ? vm.getTrue() : vm.getFalse();
}

FERAL_FUNC(bytebufferCopy, 0, false,
           "  var.fn() -> Bytebuffer\n"
           "Copies the bytebuffer data and returns it.")
{
    VarBytebuffer *b = as<VarBytebuffer>(args[0]);
    return vm.makeVar<VarBytebuffer>(loc, b->capacity(), b->size(), b->getVal());
}

FERAL_FUNC(byteBufferAt, 1, false,
           "  var.fn(position) -> Int | Nil\n"
           "Returns the byte at index `position` in bytebuffer `var` as int,"
           " or `nil` if `position` is out of range in `var`.")
{
    EXPECT(VarInt, args[1], "index");
    VarBytebuffer *res = as<VarBytebuffer>(args[0]);
    size_t pos  = as<VarInt>(args[1])->getVal();
    if(pos >= res->size()) return vm.getNil();
    return vm.makeVar<VarInt>(loc, res->at(pos));
}

FERAL_FUNC(bytebufferCapacity, 0, false,
           "  var.fn() -> Int\n"
           "Returns the capacity in bytes of the Bytebuffer `var`.")
{
    return vm.makeVar<VarInt>(loc, as<VarBytebuffer>(args[0])->capacity());
}

FERAL_FUNC(bytebufferLen, 0, false,
           "  var.fn() -> Int\n"
           "Returns the number of bytes contained within the Bytebuffer `var`.")
{
    return vm.makeVar<VarInt>(loc, as<VarBytebuffer>(args[0])->size());
}

} // namespace fer