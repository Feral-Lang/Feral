// Used in Core.hpp

#if defined(BUILDING_WITH_CMAKE)

constexpr char const *PROJECT_NAME = "@PROJECT_NAME@";

constexpr int PROJECT_MAJOR = @PROJECT_VERSION_MAJOR@;
constexpr int PROJECT_MINOR = @PROJECT_VERSION_MINOR@;
constexpr int PROJECT_PATCH = @PROJECT_VERSION_PATCH@;

constexpr char const *PROJECT_VERSION_STR = "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@";

constexpr char const *CMAKE_BUILD_TYPE = "@CMAKE_BUILD_TYPE@";
constexpr char const *BUILD_COMPILER   = "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@";
constexpr char const *BUILD_DATE       = "@BUILD_DATE@";

constexpr char const *REPO_URL    = "@REPO_URL@";
constexpr char const *COMMIT_ID   = "@COMMIT_ID@";
constexpr char const *TREE_STATUS = "@TREE_STATUS@";

constexpr char const *MIN_CMAKE_VERSION  = "@CMAKE_MINIMUM_REQUIRED_VERSION@";
constexpr char const *USED_CMAKE_VERSION = "@CMAKE_VERSION@";

#else

constexpr char const *PROJECT_NAME = "$<<PACKAGE_NAME>>";

constexpr int PROJECT_MAJOR = $<<PACKAGE_VERSION_MAJOR>>;
constexpr int PROJECT_MINOR = $<<PACKAGE_VERSION_MINOR>>;
constexpr int PROJECT_PATCH = $<<PACKAGE_VERSION_PATCH>>;

constexpr char const *PROJECT_VERSION_STR = "$<<PACKAGE_VERSION_MAJOR>>.$<<PACKAGE_VERSION_MINOR>>.$<<PACKAGE_VERSION_PATCH>>";

constexpr char const *BUILD_TYPE     = "$<<BUILD_TYPE>>";
constexpr char const *BUILD_COMPILER = "$<<COMPILER_ID>> $<<COMPILER_VERSION>>";
constexpr char const *BUILD_DATE     = "$<<TIMESTAMP>>";

constexpr char const *REPO_URL    = "$<<REPO_URL>>";
constexpr char const *COMMIT_ID   = "$<<COMMIT_ID>>";
constexpr char const *TREE_STATUS = "$<<TREE_STATUS>>";

#endif // defined(BUILDING_WITH_CMAKE)