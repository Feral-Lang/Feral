let assert = import('std/assert');

let io = import('std/io');
let os = import('std/os');
let time = import('std/time');
let async = import('std/async');

let atime = 10, btime = 20, expected = feral.buildType == 'Release' ? 22 : 28;
# valgrind is slowwwwwwwwwww
if os.getEnv('VALGRIND_ENABLED') {
    atime = 40;
    btime = 50;
    expected = 200;
}

let func = fn(id, sleepFor) {
    io.println('hello ', id);
    await os.sleepAsync(sleepFor);
    io.println('world ', id);
};

let runner = async.newRunner();
runner.push(func, 'a', atime);
runner.push(func, 'b', btime);

let timeBegin = time.now();
runner.run();
let timeTotal = time.now() - timeBegin;
assert.le(time.resolve(timeTotal, time.milli).round(), expected);